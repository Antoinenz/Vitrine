# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Public origin of the site. Required in production for correct absolute URLs
# (OpenGraph tags, share links) and for SvelteKit's CSRF origin check.
ORIGIN=http://localhost:3000

# Everything mutable lives here: the SQLite database, uploaded originals and
# generated renditions. Backing up the install means copying this directory.
DATA_DIR=./data

# Relative paths are resolved inside DATA_DIR.
DATABASE_URL=gallery.db

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# IMPORTANT: adapter-node defaults BODY_SIZE_LIMIT to 512kb, which rejects every
# realistic photo upload with a 413. It must be raised to at least MAX_UPLOAD_MB.
# If you put a reverse proxy in front, raise its limit too (nginx:
# `client_max_body_size 512M;` — Caddy has no request body limit by default).
BODY_SIZE_LIMIT=512M

# Largest single file accepted, in megabytes.
MAX_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Image processing
# ---------------------------------------------------------------------------

# Rendition formats, most-preferred first. AVIF compresses better but is slow to
# encode; on modest hardware, `webp` alone is a reasonable trade.
IMAGE_FORMATS=avif,webp

# Photos processed in parallel. Each pipeline holds a decoded bitmap in memory,
# so raise this only if you have RAM to spare.
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# First-boot admin account
# ---------------------------------------------------------------------------

# Used only when no user exists yet. The app forces a password change on first
# login, so this credential can't quietly remain valid.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-on-first-login

# Days a login stays valid.
SESSION_TTL_DAYS=30
